{
  "name": "limetry",
  "version": "1.2.75",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "workspaces": [
    "packages/*",
    "!packages/cloud",
    "!packages/pulumi-neon",
    "examples/*"
  ],
  "scripts": {
    "build:ci": "yarn workspace @limetry/ci build",
    "build:cli": "yarn workspace @limetry/cli build",
    "build:infra:artifacts": "yarn build:sdk && yarn build:preflight && yarn build:lambda && yarn build:web:static",
    "build:lambda": "yarn workspace @limetry/server build:lambda",
    "build:preflight": "yarn workspace @limetry/preflight build",
    "build:sdk": "yarn workspace @limetry/sdk build",
    "build:server": "yarn workspace @limetry/server build",
    "build:shopify": "yarn workspace @limetry/shopify build",
    "build:sql": "yarn workspace @limetry/sql build",
    "build:web:static": "LIMETRY_STATIC_EXPORT=1 yarn workspace @limetry/web build",
    "build:web": "yarn workspace @limetry/web build",
    "build": "yarn build:sdk && yarn build:preflight && yarn build:server && yarn build:cli && yarn build:ci && yarn build:sql && yarn build:shopify && yarn build:web",
    "deploy:vercel": "tsx scripts/deploy-vercel.ts",
    "dev:cli": "yarn workspace @limetry/cli dev",
    "dev:mcp": "yarn workspace @limetry/mcp build && node packages/mcp/dist/index.js",
    "dev:server": "yarn workspace @limetry/server dev",
    "dev:web": "yarn workspace @limetry/web dev",
    "dev": "yarn dev:web",
    "docs:api:watch": "typedoc --options typedoc.json --watch",
    "docs:api": "typedoc --options typedoc.json",
    "docs:check": "tsx scripts/docs-regen.ts",
    "docs:openapi": "tsx scripts/docs-regen.ts --openapi-only",
    "docs:watch": "yarn docs:api:watch",
    "docs": "tsx scripts/docs-regen.ts",
    "lint:fix": "eslint . --fix",
    "lint": "eslint .",
    "publish:all": "yarn publish:build && npm publish ./packages/sdk --access public && npm publish ./packages/ci --access public && npm publish ./packages/cli --access public && npm publish ./packages/mcp --access public && npm publish ./packages/preflight --access public && npm publish ./packages/shopify --access public && npm publish ./packages/sql --access public && npm publish ./packages/ui --access public",
    "publish:build": "yarn build:sdk && yarn build:preflight && yarn build:cli && yarn workspace @limetry/mcp build && yarn build:ci && yarn build:shopify && yarn build:sql && yarn workspace @limetry/ui build",
    "publish:ci": "yarn build:ci && npm publish ./packages/ci --access public",
    "publish:cli": "yarn build:cli && npm publish ./packages/cli --access public",
    "publish:mcp": "yarn workspace @limetry/mcp build && npm publish ./packages/mcp --access public",
    "publish:preflight": "yarn build:preflight && npm publish ./packages/preflight --access public",
    "publish:sdk": "yarn build:sdk && npm publish ./packages/sdk --access public",
    "publish:shopify": "yarn build:shopify && npm publish ./packages/shopify --access public",
    "publish:sql": "yarn build:sql && npm publish ./packages/sql --access public",
    "publish:ui": "yarn workspace @limetry/ui build && npm publish ./packages/ui --access public",
    "release:vercel": "tsx scripts/sync-version.ts --deploy=vercel",
    "release": "tsx scripts/sync-version.ts",
    "start": "yarn workspace @limetry/web start",
    "sync-version": "tsx scripts/sync-version.ts --sync-only",
    "test:ci": "yarn workspace @limetry/ci test",
    "test:cli": "yarn workspace @limetry/cli test",
    "test:e2e": "tsx scripts/run-workspaces.ts test:e2e --exclude limetry --exclude @limetry/skill",
    "test:examples": "tsx scripts/run-workspaces.ts test --exclude limetry --exclude @limetry/skill --include '@examples/*'",
    "test:preflight": "yarn workspace @limetry/preflight test",
    "test:sdk": "yarn workspace @limetry/sdk test",
    "test:server": "yarn workspace @limetry/server test",
    "test:shopify": "yarn workspace @limetry/shopify test",
    "test:sql": "yarn workspace @limetry/sql test",
    "test:ui": "yarn workspace @limetry/ui test",
    "test:web": "yarn workspace @limetry/web test",
    "test": "tsx scripts/run-workspaces.ts test --exclude limetry --exclude @limetry/skill",
    "typecheck": "tsx scripts/run-workspaces.ts typecheck --exclude limetry --exclude @limetry/skill",
    "watch:vercel": "tsx scripts/watch-vercel.ts"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.23.0",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "16.3.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "bcryptjs": "^3.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.12.0",
    "jsonwebtoken": "^9.0.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "4.1.11"
  },
  "resolutions": {
    "hono": "4.13.2",
    "@hono/node-server": "1.19.17",
    "nanoid": "3.3.18",
    "ip-address": "10.5.0",
    "fast-uri": "3.1.5",
    "tar": "7.5.22",
    "undici@npm:^6.25.0": "npm:6.28.0",
    "sharp": "0.35.4",
    "baseline-browser-mapping": "2.11.21",
    "browserslist": "4.28.9",
    "esbuild": "0.28.2",
    "qs": "6.16.0",
    "js-yaml": "4.3.2",
    "postcss": "8.5.23",
    "brace-expansion": "5.0.9",
    "minimatch@npm:3.1.5>brace-expansion": "1.1.12",
    "next": "16.3.4",
    "vitest": "4.1.11",
    "@vitest/coverage-v8": "4.1.11"
  }
}
