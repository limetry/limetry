# Limetry — mono-repo root environment example
# Copy this file to .env and fill in your values.
# All workspaces read from here via @dotenvx/dotenvx.

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Server listen ports ───────────────────────────────────────────────────────
# WEB_PORT=3800 — @limetry/web (next -p 3800)
# Portal (enterprise) listens on 3830 — see limetry-enterprise/.env.example
LIMETRY_API_PORT=3810

# Static bearer token for policy evaluation, approvals, and audit endpoints.
# Must be at least 16 characters locally; at least 32 unique characters outside
# development/test. Required in production.
LIMETRY_BEARER_TOKEN=your-secure-bearer-token-here

# Authentication (JWT) for user-management routes — min 32 chars.
# Must be a unique non-placeholder value outside development/test.
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long-change-in-prod

# HMAC secret for policy decision receipts (allow/deny/approval_required integrity).
# Falls back to JWT_SECRET in development/test when unset.
# Required in production — copy `.env.production.example` and generate with openssl.
# DECISION_HMAC_SECRET=

# Replay and throttling controls.
REPLAY_WINDOW_MS=300000
THROTTLE_MAX_REQUESTS_PER_MINUTE=5

# Optional Redis for nonce/throttle stores in multi-instance deployments.
# REDIS_URL=redis://localhost:6379

# USE_POSTGRES_STORE=true is required in production.
# USE_POSTGRES_STORE=false

# ─── Persistence ──────────────────────────────────────────────────────────────
# Required in production. Enables durable policies, audit log, approvals,
# users, tokens, and rules.
USE_POSTGRES_STORE=false
DATABASE_URL=postgresql://user:password@localhost:5432/limetry
# Audit storage shape when ActionPolicy.audit_mode is unset (minimal | forensics)
LIMETRY_DEFAULT_AUDIT_MODE=minimal
# Purge limetry_audit_log older than N days (0 disables). Requires USE_POSTGRES_STORE=true.
LIMETRY_AUDIT_RETENTION_DAYS=90
# LIMETRY_AUDIT_PURGE_INTERVAL_MS=3600000

# ─── SDK / CLI / MCP clients ──────────────────────────────────────────────────
LIMETRY_BASE_URL=http://localhost:3810
LIMETRY_API_KEY=

# ─── Public product URLs (optional on Vercel / production builds) ──────────────
# Unset values resolve from VERCEL_URL / canonical hosts (limetry.com, app, api).
NEXT_PUBLIC_WEB_URL=http://localhost:3800
NEXT_PUBLIC_APP_URL=http://localhost:3830
NEXT_PUBLIC_API_URL=http://localhost:3810
NEXT_PUBLIC_GITHUB_URL=https://github.com/limetry/limetry
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/VxUWz7cZP
NEXT_PUBLIC_CONTACT_EMAIL=hello@limetry.com
NEXT_PUBLIC_LEGAL_EMAIL=legal@limetry.com
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@limetry.com
NEXT_PUBLIC_LAUNCHING_SOON=false

# Social sign-in. The master switch hides Google and Apple even when those are true.
NEXT_PUBLIC_IS_SSO_ENABLED=false
NEXT_PUBLIC_IS_GOOGLE_SSO_ENABLED=true
NEXT_PUBLIC_IS_APPLE_SSO_ENABLED=true
EXPO_PUBLIC_IS_SSO_ENABLED=false
EXPO_PUBLIC_IS_GOOGLE_SSO_ENABLED=true
EXPO_PUBLIC_IS_APPLE_SSO_ENABLED=true

# Optional observability. Preflight POSTs Sentry envelope + PostHog /decide (404 ≠ OK).
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# POSTHOG_API_KEY=
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# Cloudflare DNS (Pulumi). Zone.DNS Edit + Zone.Read on limetry.org / limetry.com.
# CLOUDFLARE_API_TOKEN=
