# Limetry — mono-repo root environment example
# Copy this file to .env and fill in your values.
# All workspaces read from here via @dotenvx/dotenvx.

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Server listen ports ───────────────────────────────────────────────────────
# WEB_PORT=3800 — @limetry/web (next -p 3800)
# Portal (enterprise) listens on 3830 — see limetry-enterprise/.env.example
LIMETRY_API_PORT=3810

# Static bearer token for policy evaluation, approvals, and audit endpoints.
# Must be at least 16 characters locally; at least 32 unique characters outside
# development/test. Required in production.
LIMETRY_BEARER_TOKEN=your-secure-bearer-token-here

# Authentication (JWT) for user-management routes — min 32 chars.
# Must be a unique non-placeholder value outside development/test.
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long-change-in-prod

# HMAC secret for policy decision receipts (allow/deny/approval_required integrity).
# Falls back to JWT_SECRET in development/test when unset.
# Required in production — copy `.env.production.example` and generate with openssl.
# DECISION_HMAC_SECRET=

# Replay and throttling controls.
REPLAY_WINDOW_MS=300000
THROTTLE_MAX_REQUESTS_PER_MINUTE=5

# Optional Redis for nonce/throttle stores in multi-instance deployments.
# REDIS_URL=redis://localhost:6379

# SQLite is the default for a local, single-process server. Set
# USE_POSTGRES_STORE=true for Postgres-backed or multi-instance deployments.
# USE_POSTGRES_STORE=false

# ─── Persistence ──────────────────────────────────────────────────────────────
# SQLite path used when USE_POSTGRES_STORE=false. The directory is created on
# startup and can be replaced with an absolute path.
SQLITE_DATABASE_PATH=~/.limetry/limetry.sqlite
# Postgres enables durable, multi-instance policies, audit log, approvals,
# users, tokens, and rules.
USE_POSTGRES_STORE=false
DATABASE_URL=postgresql://user:password@localhost:5432/limetry
DATABASE_SCHEMA_NAME=evaluate
# Audit storage shape when ActionPolicy.audit_mode is unset (minimal | forensics)
LIMETRY_DEFAULT_AUDIT_MODE=minimal
# Purge limetry_audit_log older than N days (0 disables). Requires USE_POSTGRES_STORE=true.
LIMETRY_AUDIT_RETENTION_DAYS=90
# LIMETRY_AUDIT_PURGE_INTERVAL_MS=3600000

# ─── SDK / CLI / MCP clients ──────────────────────────────────────────────────
LIMETRY_BASE_URL=http://localhost:3810
LIMETRY_CLOUD_BASE_URL=http://localhost:3820
LIMETRY_API_KEY=

# ─── Public product URLs (optional on Vercel / production builds) ──────────────
# Unset values resolve from VERCEL_URL / canonical hosts (limetry.com, app, api).
NEXT_PUBLIC_WEB_URL=http://localhost:3800
# Cloud portal (enterprise @limetry/portal). Not the Cloud marketing site.
NEXT_PUBLIC_APP_URL=http://localhost:3830
NEXT_PUBLIC_API_URL=http://localhost:3810
# Cloud marketing web (enterprise @limetry/web). Used by /pricing redirect when Cloud is enabled.
NEXT_PUBLIC_CLOUD_WEB_URL=http://localhost:3812
NEXT_PUBLIC_GITHUB_URL=https://github.com/limetry/limetry
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/VxUWz7cZP
NEXT_PUBLIC_CONTACT_FORM_URL=https://app.limetry.com/contact
# When true, limetry.org shows Cloud CTAs and /pricing opens Cloud marketing (limetry.com/pricing locally).
NEXT_PUBLIC_IS_CLOUD_ENABLED=false
NEXT_PUBLIC_IS_HEADER_STICKY=true
IS_HEADER_STICKY=true
# Legacy alias; Cloud CTAs also show when IS_CLOUD_ENABLED is true.
NEXT_PUBLIC_LAUNCHING_SOON=false

# Social sign-in. The master switch hides Google and Apple even when those are true.
NEXT_PUBLIC_IS_SSO_ENABLED=false
NEXT_PUBLIC_IS_GOOGLE_SSO_ENABLED=true
NEXT_PUBLIC_IS_APPLE_SSO_ENABLED=true
EXPO_PUBLIC_IS_SSO_ENABLED=false
EXPO_PUBLIC_IS_GOOGLE_SSO_ENABLED=true
EXPO_PUBLIC_IS_APPLE_SSO_ENABLED=true

# Optional observability. Preflight POSTs Sentry envelope + PostHog /decide (404 ≠ OK).
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# POSTHOG_API_KEY=
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# Cloudflare DNS (Pulumi). Zone.DNS Edit + Zone.Read on limetry.org / limetry.com.
# CLOUDFLARE_API_TOKEN=

# ─── Ask Limetry / product assistant ───────────────────────────────────────────────────
# Retrieval backend: memory (bundled corpus JSON) | pgvector | bedrock-kb (AWS KB).
LIMETRY_ASSISTANT_BACKEND=memory
LIMETRY_ASSISTANT_CORPUS_PATH=docs/assistant/corpus/assistant-corpus.json
# Extra ingest roots (comma-separated), e.g. ../limetry-enterprise. Blank = auto-detect sibling.
LIMETRY_ASSISTANT_EXTRA_ROOTS=
# Public browser chat (marketing site). Set false to require bearer + chat:read.
LIMETRY_ASSISTANT_PUBLIC=true
# Extra CORS origins for Ask Limetry (comma-separated). Deploy also allows apex/www.
LIMETRY_ASSISTANT_CORS_ORIGINS=

# Default AWS synthesis (Bedrock). Preferred for Lambda; uses the execution role (no API key).
# Anthropic/OpenAI keys below are optional alternates and take precedence when set.
LIMETRY_BEDROCK_REGION=us-west-2
LIMETRY_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
LIMETRY_BEDROCK_MODEL_ARN=
LIMETRY_BEDROCK_KB_ID=
LIMETRY_BEDROCK_EMBED_MODEL_ID=
LIMETRY_BEDROCK_GUARDRAIL_ID=
LIMETRY_BEDROCK_GUARDRAIL_VERSION=

# Alternate portable providers (optional). If set, chat prefers these over Bedrock.
# LIMETRY_ASSISTANT_MODEL applies to Anthropic/OpenAI only (not Bedrock model ids).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LIMETRY_ASSISTANT_MODEL=

