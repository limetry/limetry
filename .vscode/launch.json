{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Run All",
      "configurations": [
        "API",
        "Web",
      ]
    }
  ],
  "configurations": [
    {
      "type": "node",
      "name": "API",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "yarn",
      "runtimeArgs": [
        "dev:server"
      ],
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "name": "Web",
      "request": "launch",
      "runtimeExecutable": "yarn",
      "runtimeArgs": [
        "dev:web"
      ],
      "console": "integratedTerminal"
    },
  ]
}
