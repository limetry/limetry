# Limetry OSS — production environment template
# Copy to `.env.production` (gitignored) or set the same keys in Pulumi / the host.
# Generate secrets with: openssl rand -hex 32
# Do not reuse development JWT_SECRET or LIMETRY_BEARER_TOKEN values.

NODE_ENV=production
LIMETRY_API_PORT=3810

# Neon (or other hosted Postgres) pooled URL. Loopback hosts are rejected at boot.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full
DATABASE_SCHEMA_NAME=evaluate
USE_POSTGRES_STORE=true

# Unique per environment. Must not match Cloud JWT_SECRET.
JWT_SECRET=replace-with-openssl-rand-hex-32-value-min-32-chars

# Shared with the Cloud BFF for this same environment only (BFF→OSS hop).
# Never expose to browsers or customer agents. Prefer hashed limetry_ tokens for agents.
LIMETRY_BEARER_TOKEN=replace-with-openssl-rand-hex-32-value-min-32-chars

# Required in production. Must not fall back to JWT_SECRET.
DECISION_HMAC_SECRET=replace-with-openssl-rand-hex-32-value-min-32-chars

REPLAY_WINDOW_MS=300000
THROTTLE_MAX_REQUESTS_PER_MINUTE=5
LIMETRY_DEFAULT_AUDIT_MODE=minimal
LIMETRY_AUDIT_RETENTION_DAYS=90

# Optional multi-instance nonce / throttle store (Upstash or compatible).
# REDIS_URL=rediss://default:PASSWORD@HOST:6379

NEXT_PUBLIC_API_URL=https://api.limetry.com
NEXT_PUBLIC_APP_URL=https://app.limetry.com
NEXT_PUBLIC_WEB_URL=https://limetry.org
NEXT_PUBLIC_CLOUD_WEB_URL=https://limetry.com
NEXT_PUBLIC_IS_CLOUD_ENABLED=true
NEXT_PUBLIC_GITHUB_URL=https://github.com/limetry/limetry
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/VxUWz7cZP
NEXT_PUBLIC_CONTACT_FORM_URL=/contact
NEXT_PUBLIC_CONTACT_PROVIDER=brevo
# NEXT_PUBLIC_CONTACT_API_URL=/api/contact
# NEXT_PUBLIC_FORMSPREE_FORM_ID=
# Server-side (Ask Limetry / assistant):
# CONTACT_PROVIDER=brevo
# BREVO_API_KEY=
# BREVO_FROM_EMAIL=hello@limetry.com
# BREVO_FROM_NAME=Limetry
# BREVO_CONTACT_TO=hello@limetry.com

# Optional observability. When set, preflight probes ingest/decide (404 ≠ reachable).
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# POSTHOG_API_KEY=
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

NEXT_PUBLIC_FEATURE_RULES=true
NEXT_PUBLIC_FEATURE_TOKENS=true
NEXT_PUBLIC_FEATURE_MULTI_TENANT=true

# ─── Ask Limetry / product assistant ───────────────────────────────────────────────────
# Retrieval backend: memory (bundled corpus JSON) | pgvector | bedrock-kb (AWS KB).
LIMETRY_ASSISTANT_BACKEND=memory
LIMETRY_ASSISTANT_CORPUS_PATH=docs/assistant/corpus/assistant-corpus.json
# Extra ingest roots (comma-separated), e.g. ../limetry-enterprise. Blank = auto-detect sibling.
LIMETRY_ASSISTANT_EXTRA_ROOTS=
# Public browser chat (marketing site). Set false to require bearer + chat:read.
LIMETRY_ASSISTANT_PUBLIC=true
# Extra CORS origins for Ask Limetry (comma-separated). Deploy also allows apex/www.
LIMETRY_ASSISTANT_CORS_ORIGINS=

# Default AWS synthesis (Bedrock). Preferred for Lambda; uses the execution role (no API key).
# Anthropic/OpenAI keys below are optional alternates and take precedence when set.
LIMETRY_BEDROCK_REGION=us-west-2
LIMETRY_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
LIMETRY_BEDROCK_MODEL_ARN=
LIMETRY_BEDROCK_KB_ID=
LIMETRY_BEDROCK_EMBED_MODEL_ID=
LIMETRY_BEDROCK_GUARDRAIL_ID=
LIMETRY_BEDROCK_GUARDRAIL_VERSION=

# Alternate portable providers (optional). If set, chat prefers these over Bedrock.
# LIMETRY_ASSISTANT_MODEL applies to Anthropic/OpenAI only (not Bedrock model ids).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LIMETRY_ASSISTANT_MODEL=

