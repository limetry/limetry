{
  "versionStyle": {
    "padPatch": false,
    "prerelease": "beta"
  },
  "stamp": [
    {
      "type": "packageJson",
      "path": "package.json"
    },
    {
      "type": "packageJson",
      "path": "packages/ci/package.json"
    },
    {
      "type": "packageJson",
      "path": "packages/cli/package.json"
    },
    {
      "type": "packageJson",
      "path": "packages/mcp/package.json"
    },
    {
      "type": "packageJson",
      "path": "packages/preflight/package.json"
    },
    {
      "type": "packageJson",
      "path": "packages/sdk/package.json"
    },
    {
      "type": "packageJson",
      "path": "packages/shopify/package.json"
    },
    {
      "type": "packageJson",
      "path": "packages/sql/package.json"
    },
    {
      "type": "packageJson",
      "path": "packages/ui/package.json"
    },
    {
      "type": "packageJson",
      "path": "packages/web/package.json"
    },
    {
      "type": "packageJson",
      "path": "packages/assistant/package.json"
    },
    {
      "type": "packageJson",
      "path": "packages/email/package.json"
    },
    {
      "type": "packageJson",
      "path": "packages/api/package.json"
    }
  ],
  "channels": {
    "prod": {
      "branch": [
        "main",
        "master"
      ],
      "prerelease": false
    },
    "dev": {
      "prerelease": true
    }
  },
  "qualityGate": "yarn workspace @limetry/sdk typecheck && yarn workspace @limetry/preflight typecheck && yarn workspace @limetry/server typecheck && yarn workspace @limetry/web typecheck && yarn docs:check",
  "deploy": [],
  "git": {
    "commitTemplate": "chore: released {version}",
    "tagTemplate": "v{version}",
    "rollbackOnDeployFailure": true,
    "extraPaths": [
      "versions/compatibility.json",
      "packages/sdk/src/compatibility.ts",
      "yarn.lock"
    ]
  }
}
