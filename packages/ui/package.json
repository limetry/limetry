{
  "name": "@limetry/ui",
  "version": "1.2.95",
  "description": "Shared design system for Limetry — components, icons, and design tokens.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "react-native": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./drawer": {
      "types": "./dist/components/drawer-menu.web.d.ts",
      "react-native": "./src/components/drawer-menu.tsx",
      "browser": "./src/components/drawer-menu.web.tsx",
      "import": "./src/components/drawer-menu.web.tsx",
      "default": "./src/components/drawer-menu.web.tsx"
    },
    "./site-header": {
      "types": "./dist/components/site-header.web.d.ts",
      "react-native": "./src/components/site-header.tsx",
      "browser": "./src/components/site-header.web.tsx",
      "import": "./src/components/site-header.web.tsx",
      "default": "./src/components/site-header.web.tsx"
    },
    "./logo": {
      "types": "./dist/components/logo.web.d.ts",
      "react-native": "./src/components/logo.tsx",
      "browser": "./src/components/logo.web.tsx",
      "import": "./src/components/logo.web.tsx",
      "default": "./src/components/logo.web.tsx"
    },
    "./site-footer": {
      "types": "./dist/components/site-footer.web.d.ts",
      "react-native": "./src/components/site-footer.tsx",
      "browser": "./src/components/site-footer.web.tsx",
      "import": "./src/components/site-footer.web.tsx",
      "default": "./src/components/site-footer.web.tsx"
    },
    "./site-footer-links": {
      "types": "./dist/lib/site-footer-links.d.ts",
      "import": "./src/lib/site-footer-links.ts",
      "default": "./src/lib/site-footer-links.ts"
    },
    "./contact-form": {
      "types": "./dist/components/contact-form.web.d.ts",
      "react-native": "./src/components/contact-form.tsx",
      "browser": "./src/components/contact-form.web.tsx",
      "import": "./src/components/contact-form.web.tsx",
      "default": "./src/components/contact-form.web.tsx"
    },
    "./theme-toggle": {
      "types": "./dist/components/theme-toggle.web.d.ts",
      "react-native": "./src/components/theme-toggle.tsx",
      "browser": "./src/components/theme-toggle.web.tsx",
      "import": "./src/components/theme-toggle.web.tsx",
      "default": "./src/components/theme-toggle.web.tsx"
    },
    "./tailwind": "./tailwind.config.ts",
    "./global.css": "./src/global.css"
  },
  "files": [
    "dist",
    "src",
    "tailwind.config.ts"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --clean --out-dir dist && yarn run -T tsgo -p tsconfig.build.json",
    "typecheck": "yarn run -T tsgo -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limetry/limetry.git",
    "directory": "packages/ui"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.41.0",
    "lucide-react-native": "^1.41.0",
    "nativewind": "^4.1.23",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native/metro-config": "^0.88.1",
    "@types/react": "~19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-css-interop": "^0.2.6",
    "react-native-reanimated": "4.7.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.0",
    "typescript": "^5.8.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.73",
    "react-native-svg": ">=15"
  }
}
