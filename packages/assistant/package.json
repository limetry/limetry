{
  "name": "@limetry/assistant",
  "version": "1.2.105",
  "private": true,
  "description": "Ask Limetry product assistant library (retrieve + synthesize for limetry.org)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "yarn run -T tsgo -p tsconfig.json --noEmit",
    "assistant:ingest": "node scripts/ingest-assistant-corpus.mjs",
    "assistant:eval": "node scripts/eval-assistant-smoke.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.97",
    "@ai-sdk/openai": "^4.0.109",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1163.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1163.0",
    "ai": "^7.0.163",
    "ajv": "^8.20.0",
    "pg": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
