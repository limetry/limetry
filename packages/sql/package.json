{
  "name": "@limetry/sql",
  "version": "1.2.64-dev.cloud-agnostic-deploymen.7",
  "description": "Postgres/Supabase MCP write gate that evaluates SQL intents with Limetry",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "limetry-sql-mcp": "dist/mcp-server.js"
  },
  "files": [
    "dist",
    "policies"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limetry/limetry.git",
    "directory": "packages/sql"
  },
  "scripts": {
    "prepack": "node ../../scripts/rewrite-workspace-protocol.mjs prepare",
    "postpack": "node ../../scripts/rewrite-workspace-protocol.mjs restore-after-pack",
    "postpublish": "node ../../scripts/rewrite-workspace-protocol.mjs restore",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "typecheck": "yarn run -T tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "pg": "^8.14.1",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "@limetry/sdk": "*",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@limetry/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.11.11",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "^5.8.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
