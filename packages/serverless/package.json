{
  "name": "@limetry/serverless",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:lambda": "node ../server/scripts/build-lambda-bundle.mjs",
    "deploy": "yarn build:lambda && sst deploy",
    "dev": "sst dev",
    "lint": "eslint config.ts sst.config.ts providers config.test.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "eslint": "^9.39.5",
    "sst": "^4.17.1",
    "typescript": "^6.0.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@pulumi/aws": "^7.49.0",
    "@pulumi/azure": "^6.40.0",
    "@pulumi/azure-native": "^3.28.0",
    "@pulumi/docker-build": "^0.0.22",
    "@pulumi/gcp": "^10.1.0",
    "@pulumi/neon": "file:sdks/neon",
    "@pulumi/pulumi": "^3.268.0",
    "@pulumi/random": "^4.21.2"
  }
}
