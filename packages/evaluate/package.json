{
  "name": "@limetry/evaluate",
  "version": "1.2.80",
  "description": "Limetry in-process action policy evaluation kernel",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "yarn run -T tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@limetry/sdk": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "^5.8.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
