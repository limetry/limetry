{
  "name": "@limetry/sdk",
  "version": "1.2.46",
  "description": "TypeScript SDK for Limetry agent action governance and telemetry",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limetry/limetry.git",
    "directory": "packages/sdk"
  },
  "scripts": {
    "prepack": "node ../../scripts/rewrite-workspace-protocol.mjs prepare",
    "postpack": "node ../../scripts/rewrite-workspace-protocol.mjs restore",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:critical-coverage": "vitest run src/privacy/redact.test.ts src/policy/slim-policy.test.ts --coverage",
    "typecheck": "tsgo -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "^5.8.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
