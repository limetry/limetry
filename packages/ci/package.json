{
  "name": "@limetry/ci",
  "version": "1.2.61",
  "description": "Limetry GitHub Action and helpers for CI privilege and release gating",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "limetry-ci": "dist/run-action.js"
  },
  "files": [
    "dist",
    "action.yml",
    "examples",
    "policies"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limetry/limetry.git",
    "directory": "packages/ci"
  },
  "scripts": {
    "prepack": "node ../../scripts/rewrite-workspace-protocol.mjs prepare",
    "postpack": "node ../../scripts/rewrite-workspace-protocol.mjs restore-after-pack",
    "postpublish": "node ../../scripts/rewrite-workspace-protocol.mjs restore",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "typecheck": "yarn run -T tsgo -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@limetry/sdk": "*"
  },
  "devDependencies": {
    "@limetry/sdk": "workspace:*",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "^5.8.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
